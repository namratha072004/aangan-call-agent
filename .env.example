# Neon (pooled connection string, project aangan-studio, Singapore)
DATABASE_URL=

# Gemini Flash classifier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_FINAL=gemini-3.8-flash

# Shared secret Vaani sends in the x-aangan-secret header when calling /api/qualify
QUALIFY_SECRET=
# One shared password for the dashboard (username: aangan)
DASHBOARD_PASSWORD=
# Public base URL of the deployment, used for transcript links in Telegram
APP_BASE_URL=http://localhost:3000

# Telegram designer handoff (skipped if empty)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Cal.com booking (skipped if empty)
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# HubSpot CRM (skipped if empty). Private app token with contacts + deals write.
HUBSPOT_TOKEN=

# --- build_config.md §1 switches ---
START_WINDOW_WEEKS=10
MIN_PROJECT_WEEKS=11
# NIKHIL TO DECIDE. Empty = the timeline never closes a call.
TIMELINE_CLOSE_WEEKS=
# OFF until Nikhil approves the floor numbers. While off, a budget below the floor is flagged budget_mismatch.
BUDGET_CLOSE_ENABLED=false
REPEAT_CALLER_DAYS=7

# --- build_config.md §2 budget floor (code only, never shown to the model). ---
# Fill from build_config.md §2 (kept out of git). Empty = the budget check cannot fail.
BUDGET_FLOOR_FRACTION=
BUDGET_FLOOR_RES_PER_SQFT=
BUDGET_FLOOR_PER_ROOM=
BUDGET_FLOOR_COM_PER_SQFT=

# Cal.com needs an attendee email; phone callers rarely give one, so bookings use this studio inbox.
CALCOM_ATTENDEE_FALLBACK_EMAIL=

# --- Cost rates. PLACEHOLDERS: empty = cost shows "Set your inputs". ---
VAANI_INR_PER_MIN=
GEMINI_INR_PER_1M_INPUT=
GEMINI_INR_PER_1M_OUTPUT=
